{
  "name": "@norbert-fila/fullsnap",
  "version": "0.1.5",
  "description": "Capture stable full-page screenshots of websites across desktop, mobile, and custom viewports.",
  "type": "module",
  "bin": {
    "fullsnap": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nubet/fullsnap.git"
  },
  "homepage": "https://github.com/Nubet/fullsnap#readme",
  "bugs": {
    "url": "https://github.com/Nubet/fullsnap/issues"
  },
  "keywords": [
    "screenshot",
    "full-page-screenshot",
    "website-screenshot",
    "responsive-testing",
    "visual-regression",
    "visual-testing",
    "cross-browser-testing",
    "viewport-testing",
    "playwright",
    "cli"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "playwright": "^1.42.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "@norbert-fila/config": "workspace:*",
    "@norbert-fila/core": "workspace:*",
    "@norbert-fila/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
